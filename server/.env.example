# AIリレーサーバの環境変数(キー名のみ。実際の値はここに書かない)
# 実際の値はパスワードマネージャ/クラウドのシークレットストアで管理し、
# デプロイ先の環境変数に設定する。詳細は docs/接続情報.md を参照。

# Anthropic APIキー(必須) — https://console.anthropic.com で発行
ANTHROPIC_API_KEY=

# 使用モデル(省略時 claude-opus-5)
ANTHROPIC_MODEL=

# アプリからのアクセスを制限する共有トークン(推奨)。設定するとx-relay-tokenヘッダ必須
RELAY_TOKEN=

# CORSで許可するオリジン(省略時 * 。本番では https://emcyrup.github.io に絞る)
ALLOWED_ORIGIN=

# 待受ポート(省略時 8787)
PORT=
